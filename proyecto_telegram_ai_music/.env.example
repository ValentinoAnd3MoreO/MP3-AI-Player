MONGO_URI=mongodb://localhost:27017
MONGO_DB=mp3_ai_player
MONGO_COLLECTION=songs

# Telegram: crea el bot desde @BotFather
TELEGRAM_BOT_TOKEN=token_del_bot_de_telegram

# Compatible con API OpenAI (OpenAI, Ollama, LM Studio y otros proveedores)
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=api_key_del_proveedor
AI_TIMEOUT_SECONDS=30
AI_TOP_RESULTS=5

# Búsqueda opcional en Internet mediante Tavily.
# La selección final siempre queda limitada a canciones existentes en MongoDB.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# ESP32 + DFPlayer Mini. Desactivado hasta configurar el ESP32 y la microSD.
PLAYER_ENABLED=false
ESP32_BASE_URL=http://192.168.1.50:8080
ESP32_API_TOKEN=replace_with_the_same_random_token_as_esp32_config
